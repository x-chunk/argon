{
  "realm": "argon",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 300,
  "clientScopes": [
    {
      "name": "notes:write",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" }
    },
    {
      "name": "notes:read",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" }
    }
  ],
  "clients": [
    {
      "clientId": "argon-mcp",
      "description": "The MCP server itself; used only to authenticate introspection calls.",
      "enabled": true,
      "publicClient": false,
      "secret": "argon-mcp-secret",
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "argon-test",
      "description": "Test caller; tokens carry the Argon audience.",
      "enabled": true,
      "publicClient": false,
      "secret": "argon-test-secret",
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect",
      "defaultClientScopes": ["notes:read"],
      "optionalClientScopes": ["notes:write"],
      "protocolMappers": [
        {
          "name": "argon-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "http://localhost:9090", "access.token.claim": "true", "id.token.claim": "false" }
        },
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": { "access.token.claim": "true", "introspection.token.claim": "true" }
        }
      ]
    },
    {
      "clientId": "argon-other",
      "description": "Caller whose tokens are minted for a different resource.",
      "enabled": true,
      "publicClient": false,
      "secret": "argon-other-secret",
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "other-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "http://localhost:9999", "access.token.claim": "true", "id.token.claim": "false" }
        }
      ]
    }
  ]
}
